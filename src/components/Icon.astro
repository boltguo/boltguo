---
/** Simple navigation arrows; brand logos are loaded from their original assets. */
export type IconName = 'arrow-up-right';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;
const icons: Record<IconName, string[]> = {
  'arrow-up-right': ['M6 18 L18 6', 'M6 6 H18 V18'],
};
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {icons[name].map((d) => <path d={d} />)}
</svg>
