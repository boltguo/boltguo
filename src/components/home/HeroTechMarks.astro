<div class="hero-tech-marks" aria-label="More tools and technologies I use">
  {
    marks.map(({ id, label, color, size, tilt, path }) => (
      <svg
        class={`hero-tech-mark hero-tech-mark--${id}`}
        style={`--tool-color: ${color}; --tool-size: ${size}; --tool-tilt: ${tilt};`}
        viewBox="0 0 24 24"
        role="img"
        aria-label={`${label} logo`}
      >
        <path d={path} />
      </svg>
    ))
  }
</div>
