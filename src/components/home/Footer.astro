---
import { socials } from '../../data/projects';
import SvgIcon from '../SvgIcon.astro';
---

<footer class="site-footer">
  <nav class="social-links" aria-label="Social profiles">
    {
      socials.map(({ name, icon, href }) => (
        <a
          href={href}
          target="_blank"
          rel="noreferrer"
          aria-label={name}
          title={name}
        >
          <SvgIcon name={icon} size={22} />
        </a>
      ))
    }
  </nav>
  <div class="footer-status">
    <a
      class="footer-music"
      href="https://open.spotify.com/playlist/0isPRO7ymci9UDcV6a6yqE?si=O-2sWiDLQESYXsnLgkWrrQ"
      target="_blank"
      rel="noreferrer"
      aria-label="Listen to my Music playlist on Spotify"
    >
      <span class="footer-equalizer" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
      <span>Music</span>
    </a>
    <span aria-hidden="true">&amp;</span>
    <a
      class="footer-coding"
      href="https://github.com/boltguo"
      target="_blank"
      rel="noreferrer"
      aria-label="Explore my coding projects on GitHub"
    >
      <span>Coding...</span>
    </a>
  </div>
</footer>
