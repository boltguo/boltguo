---
import Icon from '../Icon.astro';
import BrandIcon from '../BrandIcon.astro';
import SvgIcon from '../SvgIcon.astro';
import { projects } from '../../data/projects';

const sections = [
  {
    id: 'projects',
    title: 'Projects',
    items: projects.filter((project) => !project.footerOnly),
  },
  {
    id: 'more',
    title: 'More',
    items: projects.filter((project) => project.footerOnly),
  },
];
---

{
  sections.map(({ id, title, items }) => (
    <section class="project-section" id={id} aria-labelledby={`${id}-title`}>
      <h2 id={`${id}-title`}>{title}</h2>
      <ul class="project-list">
        {items.map((project) => (
          <li>
            <a
              class="project-link"
              href={project.link}
              aria-label={`${project.title}: ${project.summary}`}
              target="_blank"
              rel="noreferrer"
            >
              <span class="project-logo" aria-hidden="true">
                {project.iconSprite ? (
                  <span
                    class={`project-sprite project-sprite--${project.iconSprite}`}
                  />
                ) : project.icon ? (
                  <SvgIcon
                    name={project.icon}
                    size={16}
                    viewBox={
                      project.icon === 'logo' ? '110 110 500 500' : undefined
                    }
                  />
                ) : project.iconBrand ? (
                  <BrandIcon name={project.iconBrand} size={16} />
                ) : (
                  <SvgIcon name="logo" size={16} />
                )}
              </span>
              <span class="project-copy">
                <span class="project-name">{project.title}</span>
                <span class="project-separator" aria-hidden="true">
                  {' '}
                  ~{' '}
                </span>
                <span class="project-summary">{project.summary}</span>
              </span>
              <span class="project-meta" aria-hidden="true">
                <span class="project-resting-meta">
                  <Icon name="arrow-up-right" size={16} class="project-arrow" />
                </span>
                <span class="project-destination">
                  <span>
                    {new URL(project.link).hostname.replace(/^www\./, '')}
                  </span>
                  <Icon name="arrow-up-right" size={16} />
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))
}
