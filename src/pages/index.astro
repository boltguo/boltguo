---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import Projects from '../components/home/Projects.astro';
import HomeFooter from '../components/home/Footer.astro';
import Icon from '../components/Icon.astro';
import SvgIcon from '../components/SvgIcon.astro';
---

<Layout
  title="Bolt Guo | Software developer"
  description="I'm Bolt Guo, a software developer with a frontend background. I build projects to explore ideas and learn how things work."
>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="site-shell">
    <header class="site-header">
      <a class="site-logo" href="/" aria-label="AOUOS home">
        <SvgIcon name="logo" size={36} />
      </a>
      <a
        class="header-github"
        href="https://github.com/boltguo"
        target="_blank"
        rel="noreferrer"
      >
        GitHub <Icon name="arrow-up-right" size={16} />
      </a>
    </header>
    <main id="main" tabindex="-1">
      <Hero />
      <Projects />
    </main>
    <HomeFooter />
  </div>
</Layout>
